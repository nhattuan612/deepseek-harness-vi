{
  "name": "deepseek-harness-vi",
  "version": "0.1.0",
  "description": "Vietnamese language pack for the DeepSeek Harness web UI",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./src/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.2-rc.1 <0.2.0 || >=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.2.0 || >=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale"],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": "git+https://github.com/nhattuan612/deepseek-harness-vi.git",
  "files": ["index.js", "src/client/index.js", "cordis.patch.yml", "catalog/vi.json", "locale/*.json"],
  "scripts": {
    "build:catalog": "bun scripts/build-catalog.mjs",
    "check": "bun scripts/build-catalog.mjs --check && bun scripts/test-plugin.mjs",
    "check:upstream": "bun scripts/check-upstream.mjs"
  }
}
